{
  "id": "root",
  "cloned_from": {
    "name": "board",
    "version": "0.1.16"
  },
  "type": "column",
  "titlebar": "none",
  "preview": "mods/board-side/preview.svg",
  "ui_font": "Geist",
  "font_size": 13,
  "background": "canvas",
  "terminal_padding": [12, 10],
  "gap": 0,
  "resizable": false,
  "children": [
    {
      "id": "board-header",
      "type": "block",
      "size": { "px": 100 },
      "window_drag": true,
      "content": {
        "mod": "board-side",
        "props": { "role": "header" }
      }
    },
    {
      "id": "body",
      "type": "row",
      "resizable": true,
      "gap": 0,
      "divider": { "width": 1, "color": "border" },
      "children": [
        {
          "id": "workspace",
          "type": "column",
          "size": { "weight": 1 },
          "min": 320,
          "padding": [12, 16],
          "gap": 0,
          "resizable": false,
          "children": [
            {
              "id": "workspace-title",
              "type": "block",
              "size": { "px": 34 },
              "background": "chrome",
              "radius": 7,
              "content": {
                "mod": "board-side",
                "props": { "role": "terminals" }
              }
            },
            {
              "id": "live-terminals",
              "type": "block",
              "background": "canvas",
              "content": {
                "tab": "active",
                "pane": {
                  "gap": 12,
                  "radius": 7,
                  "background": "background",
                  "lone": true,
                  "border": { "width": 1, "color": "border" },
                  "focus": { "width": 1, "color": "accent" },
                  "header": {
                    "content": {
                      "mod": "board-side",
                      "props": { "role": "pane" }
                    },
                    "height": 28,
                    "position": "top",
                    "reveal": "always"
                  }
                }
              }
            }
          ]
        },
        {
          "id": "board-cards",
          "type": "block",
          "size": { "px": 520 },
          "min": 260,
          "max": 760,
          "content": { "mod": "board-side" }
        }
      ]
    }
  ]
}
